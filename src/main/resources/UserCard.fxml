<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<Pane
        layoutX="500" layoutY="10"
        style= " -fx-background-color: transparent;"
        stylesheets="@UserCard.css"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="UserCard">
    <Rectangle arcHeight="10" arcWidth="10"  styleClass="user-card" width="200" height="200"/>

    <VBox alignment="CENTER" prefHeight="200" prefWidth="200" spacing="10">
<!--<Button-->
<!--    alignment="TOP_CENTER"-->
<!--    styleClass="user-card"-->
<!--    prefHeight="300" prefWidth="300">-->
<!--</Button>-->
        <VBox fx:id="userInfo" alignment="CENTER">
                    <Label fx:id="idLabel" styleClass="idLabel" />
                    <Label fx:id="nameLabel" styleClass="nameLabel" />
                    <Label fx:id="rankLabel" styleClass="rankLabel" alignment="CENTER"  />
        </VBox>
        <HBox fx:id="loginHbox" alignment="CENTER" spacing="10" >
                <Button styleClass="btn" text="Login" onMouseReleased="#initLoginMenu" />
                <Button  styleClass="btn" text="Register" onMouseReleased="#initRegisterMenu" />
        </HBox>

<!--    <Label  styleClass="idLabel" text="${id}" />-->
<!--    <Label  styleClass="nameLabel" text="${name}"/>-->
<!--    <Label  styleClass="rankLabel" text="${rank}"/>-->
    </VBox>


    <VBox fx:id="loginCard" alignment="CENTER" spacing="10"  visible="false" prefHeight="200" prefWidth="200">
        <HBox>
            <Label styleClass="nameLabel" text="name:"/>
            <TextField fx:id="loginName"/>
        </HBox>
        <HBox>
            <Label styleClass="nameLabel" text="password:"/>
            <PasswordField fx:id="loginPWD"/>
        </HBox>
        <Button onMouseReleased="#loginSubmit" text="submit"/>
    </VBox>
    <VBox fx:id="registerCard" alignment="CENTER" spacing="10"  visible="false" prefHeight="200" prefWidth="200">
        <HBox>
            <Label styleClass="nameLabel" text="name:"/>
            <TextField fx:id="registerName"/>
        </HBox>
        <HBox>
            <Label styleClass="nameLabel" text="password:"/>
            <PasswordField fx:id="registerPWD"/>
        </HBox>
        <HBox>
            <Label styleClass="nameLabel" text="confirm password:"/>
            <PasswordField fx:id="registerPWD2"/>
        </HBox>
        <Button onMouseReleased="#registerSubmit" text="submit"/>
    </VBox>
</Pane>
